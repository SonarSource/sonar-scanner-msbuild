<Project Sdk='Microsoft.NET.Sdk'>

    <PropertyGroup>
        <!-- Isolate this generated sample project from the repository's own Directory.Build.props/targets (e.g. Tests/Directory.Build.targets),
             which would otherwise inject test-only PackageReferences and global usings into what is meant to be a standalone consumer project. -->
        <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
        <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <TargetFramework>TARGET_FRAMEWORK</TargetFramework>
    </PropertyGroup>

    <!-- Remove items that MSBuild automatically adds to the project -->
    <ItemGroup>
        <None Remove="**\*" />
    </ItemGroup>

    <!--SonarQube Properties-->
    SONARQUBE_PROPERTIES

    <!-- Test-specific data -->
    TEST_SPECIFIC_XML

    <!-- Standard boilerplate closing imports -->
    <Import Project='SQ_IMPORTS_BEFORE'/>
</Project>
