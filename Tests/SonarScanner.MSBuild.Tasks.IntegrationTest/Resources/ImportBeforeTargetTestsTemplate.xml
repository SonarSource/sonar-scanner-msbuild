<Project Sdk='Microsoft.NET.Sdk'>

    <PropertyGroup>
        <!-- Isolate the generated project from Tests/Directory.Build.targets: it adds package references and global usings that only apply to the test projects of this repository. -->
        <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <TargetFramework>TARGET_FRAMEWORK</TargetFramework>
    </PropertyGroup>

    <!-- Remove items that MSBuild automatically adds to the project -->
    <ItemGroup>
        <None Remove="**\*" />
    </ItemGroup>

    <!--SonarQube Properties-->
    SONARQUBE_PROPERTIES

    <!-- Test-specific data -->
    TEST_SPECIFIC_XML

    <!-- Standard boilerplate closing imports -->
    <Import Project='SQ_IMPORTS_BEFORE'/>
</Project>
